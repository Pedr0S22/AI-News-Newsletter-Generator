# ==============================================================================
# Backend Configuration
# ==============================================================================
LOG_LEVEL=INFO

# API Server
API_PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_news

# Crawl4AI Service
CRAWL4AI_PORT=11235
CRAWL4AI_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=

# Ingestion Tuning
MAX_ARTICLE_AGE_DAYS=7

# ChatGPT 5.5 (IAedu)
CHATGPT_55_ENDPOINT=
CHATGPT_55_API_KEY=
CHATGPT_55_CHANNEL_ID=

# Hybrid LLM Provider Routing (ollama | iaedu)
# Recommended: Local Ollama for high-volume Evaluation, IAedu GPT-5.5 for Newsletter Writing
EVAL_LLM_PROVIDER=ollama
WRITER_LLM_PROVIDER=iaedu

# Local Ollama (Host RTX 4060 GPU via host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_REASONING_EFFORT=none

# Multi-Agent Evaluation & Ranking
DEFAULT_TOP_N=3
MAX_TOP_N=5
WEIGHT_FACTUALITY=0.5
WEIGHT_HYPE=0.5
REPUTATION_DEFAULT=1.0
REPUTATION_MIN=0.3
REPUTATION_MAX=1.5
AGENT_MAX_CONCURRENCY=1
REFLECTION_MAX_ITERATIONS=3

# Newsletter & Email Delivery (Mailpit)
NEWSLETTER_DEFAULT_TITLE=AI Pulse Digest
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=newsletter@aipulse.local
SMTP_FROM_NAME=AI Pulse Digest
